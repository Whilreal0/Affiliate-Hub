# Copy to .env.local. Blank Convex URL enables the browser-only demo.
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
PUBLIC_SITE_URL=http://localhost:5173
# Netlify: set the PUBLIC_ values in its dashboard for Builds and Functions.
# Netlify runs build:netlify; it does not need ORIGIN, HOST, PORT, or npm start.
# Written by npx convex dev after selecting your project:
CONVEX_DEPLOYMENT=
# Optional CI secret: used only by npx convex deploy
CONVEX_DEPLOY_KEY=
# adapter-node production configuration
ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000
# Optional behind a trusted reverse proxy only:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
