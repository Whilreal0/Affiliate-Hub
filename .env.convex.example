# These belong in the Convex deployment dashboard, NOT public client variables.
# Use npx convex env set NAME VALUE for each, or the dashboard Settings > Environment Variables.
SITE_URL=http://localhost:5173
# Optional comma-separated exact additional app origins, e.g. your Netlify URL.
# Both the main SITE_URL and these origins can receive OAuth callbacks.
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Comma-separated verified Google emails allowed to view all registered users.
# Blank means no super admin. This is a Convex server setting, never PUBLIC_.
SUPER_ADMIN_EMAILS=your-google-email@example.com
