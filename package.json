{
  "name": "ai-affiliate-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "backend": "convex dev",
    "backend:deploy": "convex deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:backend": "tsc -p src/convex/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node build",
    "build:netlify": "node scripts/build-netlify.mjs",
    "test:netlify": "node scripts/test-netlify.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@lucide/svelte": "^1.61.0",
    "@mmailaender/convex-better-auth-svelte": "^0.10.0",
    "better-auth": "~1.6.15",
    "convex": "^1.25.0",
    "convex-svelte": "^0.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "convex-test": "^0.0.64",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
